{
  "name": "printdesk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:api": "pnpm --filter @printdesk/api dev",
    "dev:web": "pnpm --filter @printdesk/web dev",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @printdesk/api test:e2e",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
